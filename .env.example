# Optional performance/settings overrides
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-zh
TRANSLATION_BATCH=8
FINAL_CRF=18

